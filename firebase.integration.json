{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "functions": { "source": "apps/functions" },
  "hosting": {
    "public": "apps/web/dist",
    "cleanUrls": true,
    "rewrites": [
      { "source": "/mcp", "function": { "functionId": "mcp", "region": "asia-east1" } },
      {
        "source": "/.well-known/oauth-protected-resource{,/**}",
        "function": { "functionId": "mcp", "region": "asia-east1" }
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9199 },
    "firestore": { "port": 8180, "websocketPort": 9160 },
    "functions": { "port": 5101 },
    "hosting": { "port": 5102 },
    "hub": { "port": 4510 },
    "logging": { "port": 4610 },
    "eventarc": { "port": 9399 },
    "tasks": { "port": 9599 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
